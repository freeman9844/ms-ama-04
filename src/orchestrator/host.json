{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "durableTask": {
      "hubName": "lending",
      "storageProvider": { "maxQueuePollingInterval": "00:00:02" }
    },
    "queues": { "messageEncoding": "none", "maxDequeueCount": 5, "maxPollingInterval": "00:00:02" }
  },
  "logging": {
    "applicationInsights": { "samplingSettings": { "isEnabled": false } }
  }
}
